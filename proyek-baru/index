<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Proyek Bootstrap Lokal</title>
  
  <!-- Panggil Bootstrap CSS Lokal -->
  <link rel="stylesheet" href="css/bootstrap.min.css">
  <link rel="stylesheet" href="css/style.css">
</head>
<body class="bg-light">

  <div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 500px;">
      <div class="card-body text-center">
        <h2 class="card-title text-primary font-monospace">Bootstrap Lokal Ready! 🚀</h2>
        <p class="card-text text-muted">Proyek ini jalan tanpa perlu koneksi internet sama sekali gess.</p>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalLokal">
          Coba Fitur JS (Modal)
        </button>
      </div>
    </div>
  </div>

  <!-- Modal untuk tes JavaScript lokal -->
  <div class="modal fade" id="modalLokal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Tes JavaScript</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>Jika modal ini muncul saat tombol diklik, berarti file <code>bootstrap.bundle.min.js</code> lokal kamu sudah bekerja dengan benar!</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Panggil Bootstrap JS Bundle Lokal -->
  <script src="js/bootstrap.bundle.min.js"></script>
</body>
</html>